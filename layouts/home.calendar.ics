{{- /* iCalendar feed of TLUG meetings: all future plus the past 12 months.
       Served at /calendar.ics (and /ja/calendar.ics). */ -}}
{{- $lines := slice
      "BEGIN:VCALENDAR"
      "VERSION:2.0"
      "PRODID:-//Tokyo Linux Users Group//tlug.jp//EN"
      "CALSCALE:GREGORIAN"
      "METHOD:PUBLISH"
      "NAME:Tokyo Linux Users Group"
      "X-WR-CALNAME:Tokyo Linux Users Group"
      "X-WR-TIMEZONE:Asia/Tokyo"
-}}
{{- $meetings := slice -}}
{{- range hugo.Sites -}}
  {{- if eq .Language.Lang "en" -}}
    {{- $meetings = where .RegularPages "Section" "meetings" -}}
  {{- end -}}
{{- end -}}
{{- $cutoff := now.AddDate -1 0 0 -}}
{{- range $meetings.ByDate -}}
  {{- if .Date.After $cutoff -}}
    {{- $lines = $lines | append (partial "ics-event.html" .) -}}
  {{- end -}}
{{- end -}}
{{- $lines = $lines | append "END:VCALENDAR" -}}
{{- delimit $lines "\r\n" }}{{ "\r\n" -}}
